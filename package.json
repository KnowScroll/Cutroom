{
  "name": "cutroom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\" \"packages/**/*.test.ts\" \"apps/**/*.test.ts\"",
    "drift": "node scripts/drift.mjs",
    "drift:prove": "node scripts/drift.mjs --prove",
    "decisions": "node scripts/decisions.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@cutroom/api": "workspace:*",
    "@cutroom/reel-contract": "workspace:*",
    "@cutroom/worker": "workspace:*",
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.15.0",
    "dependency-cruiser": "^17.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.38.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
