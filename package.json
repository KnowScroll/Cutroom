{
  "name": "cutroom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "service": "node --experimental-strip-types --no-warnings apps/service/src/main.ts",
    "typecheck": "tsc -b --pretty",
    "lint": "node node_modules/@biomejs/biome/bin/biome check .",
    "format": "prettier --check \"**/*.md\" \"**/*.yml\" \"**/*.yaml\" \"**/*.html\"",
    "format:write": "prettier --write \"**/*.md\" \"**/*.yml\" \"**/*.yaml\" \"**/*.html\"",
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"tests/**/*.test.ts\" \"packages/**/*.test.ts\" \"apps/**/*.test.ts\"",
    "drift": "node scripts/drift.mjs",
    "drift:prove": "node scripts/drift.mjs --prove",
    "decisions": "node scripts/decisions.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint:write": "node node_modules/@biomejs/biome/bin/biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cutroom/api": "workspace:*",
    "@cutroom/benchmark": "workspace:*",
    "@cutroom/benchmark-read": "workspace:*",
    "@cutroom/contracts": "workspace:*",
    "@cutroom/pipeline": "workspace:*",
    "@cutroom/providers": "workspace:*",
    "@cutroom/reel-contract": "workspace:*",
    "@cutroom/sdk": "workspace:*",
    "@cutroom/service": "workspace:*",
    "@cutroom/worker": "workspace:*",
    "@types/node": "^22.15.0",
    "dependency-cruiser": "^17.0.0",
    "drizzle-kit": "^0.31.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "zod": "^4.6.5"
  }
}
