  "narration": [
    {
      "run_id": "ra71n657-0000-4001-8000-000000000005",
      "narration_id": "a1-shot-0-narration",
      "attempt": 1,
      "shot_unit": 0,
      "text": "A tsunami is a train of very long waves. Most are set off by the seabed moving in an earthquake.",
      "path": "<artifact>",
      "words": "[{\"word\":\"A\",\"startMs\":40,\"endMs\":120},{\"word\":\"tsunami\",\"startMs\":160,\"endMs\":600},{\"word\":\"is\",\"startMs\":640,\"endMs\":760}]",
      "probe": "{\"readable\":true,\"durationSeconds\":9.6,\"video\":null,\"audio\":{\"codec\":\"pcm_s16le\",\"sampleRate\":32000,\"channels\":1},\"moovFirst\":null}"
    },
    {
      "run_id": "ra71n657-0000-4001-8000-000000000005",
      "narration_id": "a1-shot-1-narration",
      "attempt": 1,
      "shot_unit": 1,
      "text": "In deep water the wave is low and very fast. It can cross an ocean in a few hours.",
      "path": "<artifact>",
      "words": "[{\"word\":\"A\",\"startMs\":40,\"endMs\":120},{\"word\":\"tsunami\",\"startMs\":160,\"endMs\":600},{\"word\":\"is\",\"startMs\":640,\"endMs\":760}]",
      "probe": "{\"readable\":true,\"durationSeconds\":9.6,\"video\":null,\"audio\":{\"codec\":\"pcm_s16le\",\"sampleRate\":32000,\"channels\":1},\"moovFirst\":null}"
    },
    {
      "run_id": "ra71n657-0000-4001-8000-000000000005",
      "narration_id": "a1-shot-2-narration",
      "attempt": 1,
      "shot_unit": 2,
      "text": "As the sea shallows the front slows and the water piles up. The wave can stand many metres above the shore.",
      "path": "<artifact>",
      "words": "[{\"word\":\"A\",\"startMs\":40,\"endMs\":120},{\"word\":\"tsunami\",\"startMs\":160,\"endMs\":600},{\"word\":\"is\",\"startMs\":640,\"endMs\":760}]",
      "probe": "{\"readable\":true,\"durationSeconds\":9.6,\"video\":null,\"audio\":{\"codec\":\"pcm_s16le\",\"sampleRate\":32000,\"channels\":1},\"moovFirst\":null}"
    },
    {
      "run_id": "ra71n657-0000-4001-8000-000000000005",
      "narration_id": "a1-shot-3-narration",
      "attempt": 1,
      "shot_unit": 3,
      "text": "The sea often draws back first, baring the sea floor. That withdrawal is the last warning before the water returns.",
      "path": "<artifact>",
      "words": "[{\"word\":\"A\",\"startMs\":40,\"endMs\":120},{\"word\":\"tsunami\",\"startMs\":160,\"endMs\":600},{\"word\":\"is\",\"startMs\":640,\"endMs\":760}]",
      "probe": "{\"readable\":true,\"durationSeconds\":9.6,\"video\":null,\"audio\":{\"codec\":\"pcm_s16le\",\"sampleRate\":32000,\"channels\":1},\"moovFirst\":null}"
    },
    {
      "run_id": "ra71n657-0000-4001-8000-000000000005",
      "narration_id": "a1-shot-4-narration",
      "attempt": 1,
      "shot_unit": 4,
      "text": "A buoy network measures the open sea and sends the height ashore. The warning is only useful if people are already moving uphill.",
      "path": "<artifact>",
      "words": "[{\"word\":\"A\",\"startMs\":40,\"endMs\":120},{\"word\":\"tsunami\",\"startMs\":160,\"endMs\":600},{\"word\":\"is\",\"startMs\":640,\"endMs\":760}]",
      "probe": "{\"readable\":true,\"durationSeconds\":9.6,\"video\":null,\"audio\":{\"codec\":\"pcm_s16le\",\"sampleRate\":32000,\"channels\":1},\"moovFirst\":null}"
    }
  ],
